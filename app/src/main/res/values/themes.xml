<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设置页主题：DeviceDefault.Settings 基底换品牌色，控件自动吃 accent -->
    <style name="AppTheme.Settings" parent="android:Theme.DeviceDefault.Settings">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
</resources>
